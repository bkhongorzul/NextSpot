<?xml version="1.0" encoding="utf-8"?>
<!-- Extra declarations merged in ONLY for the "pleos" build variant (Hyundai Pleos Connect). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runs on Android Automotive (Pleos Connect) -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: door (Door), seatbelt (Seat), parking brake telltale (Safety), gear (Gear) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- Pleos NaviHelper SDK: route started, driving info, current location, set destination -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- Pleos Gleo AI SDK: TextToSpeech + SpeechToText -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- Pleos Fused Location SDK -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <application>
        <activity android:name=".MainActivity">
            <!-- Allows the screen to stay usable while the car is moving -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
